# Copy this file to .env and fill in your own values.
# .env is git-ignored - never commit a real API key.
#
# The application runs fully WITHOUT any of these values. With no key set it
# runs in "Demo / fallback mode", where understanding is done by deterministic
# rules. Decisions, policy text, tickets and the audit trail are deterministic
# in both modes.

# --- LLM mode (optional) ---------------------------------------------------
# Any OpenAI-compatible chat completions endpoint works.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=12

# Examples of other providers that expose an OpenAI-compatible endpoint:
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.1-8b-instant
#
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=meta-llama/llama-3.1-8b-instruct

# --- Data ------------------------------------------------------------------
# Override only if you keep the data pack somewhere else.
# DATA_DIR=./data
